# Copy to `.env` in the project root and fill in real values.
# Never commit `.env` (it is gitignored).

# -----------------------------------------------------------------------------
# PostgreSQL (Prisma) — required for API routes and migrations
# -----------------------------------------------------------------------------
# Pooled URL (e.g. Neon “pooled” / PgBouncer). Used by the Prisma Client at runtime.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&pgbouncer=true"

# Direct URL (non-pooling). Required for `prisma migrate` and introspection.
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# -----------------------------------------------------------------------------
# Auth — JWT for `/api/login`
# -----------------------------------------------------------------------------
# Generate: openssl rand -hex 32
JWT_SECRET="your-secret-jwt-key-here"

# -----------------------------------------------------------------------------
# Cloudinary — image uploads (posts API)
# -----------------------------------------------------------------------------
CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# -----------------------------------------------------------------------------
# Optional — not read by code today; use if you switch maps to Google
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# -----------------------------------------------------------------------------
# Public app / API base URLs (client-side)
# -----------------------------------------------------------------------------
# Base URL of the public app API. All client components build API calls from this.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Base URL of the public site (used for share links such as WhatsApp).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact form endpoint (external API, complete final URL). Forms POST directly to this
# value with { nom, phone, email, message } and never append any suffix.
# If empty, forms send no request and show an inline error.
NEXT_PUBLIC_CONTACT_API_URL=""

# -----------------------------------------------------------------------------
# Node (usually set automatically by Next.js; override only if needed)
# -----------------------------------------------------------------------------
# NODE_ENV="development"
